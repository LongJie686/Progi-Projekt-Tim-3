generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// Enums
// ============================================

enum UserRole {
  STUDENT
  TUTOR
  ADMINISTRATOR
}

enum BookingStatus {
  pending
  confirmed
  completed
  cancelled
  no_show
}

enum SessionFormat {
  online
  in_person
}

enum PaymentStatus {
  pending
  processing
  completed
  failed
  refunded
}

// ============================================
// 用户系统
// ============================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  role         UserRole @default(STUDENT)
  firstName    String
  lastName     String
  avatarUrl    String?
  isActive     Boolean  @default(true)
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  oauthConnections OAuthConnection[]
  studentProfile   StudentProfile?
  tutorProfile     TutorProfile?
  bookingsAsStudent Booking[]         @relation("StudentBookings")
  bookingsAsTutor   Booking[]         @relation("TutorBookings")
  reviewsWritten    Review[]          @relation("StudentReviews")
  reviewsReceived   Review[]          @relation("TutorReviews")
  notifications     Notification[]
  favoriteTutors    FavoriteTutor[]   @relation("StudentFavorites")
  favoriteBy        FavoriteTutor[]   @relation("TutorFavoritedBy")
  notes             Note[]
  quizAttempts      QuizAttempt[]
  auditLogs         AuditLog[]
  createdQuizzes    Quiz[]            @relation("QuizCreator")

  @@index([role])
  @@map("users")
}

model OAuthConnection {
  id           String  @id @default(uuid())
  provider     String  // google, github, microsoft, fer_aai
  providerId   String
  accessToken  String?
  refreshToken String?
  userId       String
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@map("oauth_connections")
}

model StudentProfile {
  id             String  @id @default(uuid())
  userId         String  @unique
  level          String? // elementary, high_school, university
  grade          String?
  institution    String?
  learningPrefs  Json?

  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model TutorProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  bio           String?
  education     Json?
  hourlyRate30  Decimal?
  hourlyRate45  Decimal?
  hourlyRate60  Decimal?
  hourlyRate90  Decimal?
  onlineRate    Decimal?
  location      String?
  latitude      Float?
  longitude     Float?
  introVideoUrl String?
  isVerified    Boolean  @default(false)
  avgRating     Float    @default(0)
  totalReviews  Int      @default(0)
  totalSessions Int      @default(0)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects      TutorSubject[]
  timeSlots     TimeSlot[]

  @@index([avgRating])
  @@index([hourlyRate60])
  @@index([location])
  @@map("tutor_profiles")
}

// ============================================
// 科目系统
// ============================================

model Subject {
  id          String   @id @default(uuid())
  name        String
  category    String   // mathematics, physics, computer_science
  level       String   // elementary, high_school, university
  description String?

  tutorSubjects TutorSubject[]
  questions     Question[]
  bookings      Booking[]
  quizzes       Quiz[]
  notes         Note[]

  @@index([category])
  @@index([level])
  @@map("subjects")
}

model TutorSubject {
  id        String       @id @default(uuid())
  tutorId   String
  subjectId String
  tutor     TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  subject   Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([tutorId, subjectId])
  @@map("tutor_subjects")
}

// ============================================
// 预订系统
// ============================================

model TimeSlot {
  id        String       @id @default(uuid())
  tutorId   String
  dayOfWeek Int          // 0-6
  startTime String       // "09:00"
  endTime   String       // "17:00"
  tutor     TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@map("time_slots")
}

model Booking {
  id               String        @id @default(uuid())
  studentId        String
  tutorId          String
  subjectId        String
  bookingDate      DateTime
  startTime        String
  endTime          String
  format           SessionFormat @default(online)
  status           BookingStatus @default(pending)
  price            Decimal?
  notes            String?
  meetUrl          String?
  cancellationReason String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  student   User     @relation("StudentBookings", fields: [studentId], references: [id])
  tutor     User     @relation("TutorBookings", fields: [tutorId], references: [id])
  subject   Subject  @relation(fields: [subjectId], references: [id])
  payment   Payment?
  review    Review?

  @@index([tutorId, bookingDate])
  @@index([studentId])
  @@index([status])
  @@map("bookings")
}

model Payment {
  id              String        @id @default(uuid())
  bookingId       String        @unique
  stripePaymentId String?
  amount          Decimal
  platformFee     Decimal?
  status          PaymentStatus @default(pending)
  escrowReleasedAt DateTime?
  createdAt       DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// ============================================
// 评价系统
// ============================================

model Review {
  id            String   @id @default(uuid())
  bookingId     String   @unique
  studentId     String
  tutorId       String
  rating        Int
  communication Int?
  expertise     Int?
  preparation   Int?
  value         Int?
  comment       String?
  tutorResponse String?
  isModerated   Boolean  @default(false)
  createdAt     DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])
  student User    @relation("StudentReviews", fields: [studentId], references: [id])
  tutor   User    @relation("TutorReviews", fields: [tutorId], references: [id])

  @@index([tutorId])
  @@index([tutorId, rating])
  @@map("reviews")
}

// ============================================
// 测验系统
// ============================================

model Question {
  id           String   @id @default(uuid())
  subjectId    String
  type         String   // multiple_choice, short_answer, problem
  difficulty   String   // easy, medium, hard
  content      String
  options      Json?
  correctAnswer String
  explanation  String?
  points       Int      @default(1)
  createdAt    DateTime @default(now())

  subject       Subject         @relation(fields: [subjectId], references: [id])
  quizQuestions QuizQuestion[]

  @@map("questions")
}

model Quiz {
  id        String   @id @default(uuid())
  title     String
  subjectId String
  timeLimit Int?     // minutes, null = unlimited
  createdBy String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  subject   Subject        @relation(fields: [subjectId], references: [id])
  creator   User           @relation("QuizCreator", fields: [createdBy], references: [id])
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@map("quizzes")
}

model QuizQuestion {
  id         String   @id @default(uuid())
  quizId     String
  questionId String
  order      Int

  quiz     Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])

  @@index([quizId])
  @@map("quiz_questions")
}

model QuizAttempt {
  id          String    @id @default(uuid())
  quizId      String
  studentId   String
  score       Decimal?
  maxScore    Decimal?
  answers     Json?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  quiz     Quiz @relation(fields: [quizId], references: [id])
  student  User @relation(fields: [studentId], references: [id])

  @@index([quizId])
  @@index([studentId])
  @@map("quiz_attempts")
}

// ============================================
// 社交系统
// ============================================

model FavoriteTutor {
  id        String   @id @default(uuid())
  studentId String
  tutorId   String
  createdAt DateTime @default(now())

  student User @relation("StudentFavorites", fields: [studentId], references: [id], onDelete: Cascade)
  tutor   User @relation("TutorFavoritedBy", fields: [tutorId], references: [id], onDelete: Cascade)

  @@unique([studentId, tutorId])
  @@map("favorite_tutors")
}

model Note {
  id        String   @id @default(uuid())
  studentId String
  title     String
  content   String
  subjectId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id])

  @@map("notes")
}

model Homework {
  id          String    @id @default(uuid())
  bookingId   String
  tutorId     String
  title       String
  description String
  dueDate     DateTime?
  fileUrl     String?
  createdAt   DateTime  @default(now())

  @@map("homework")
}

// ============================================
// 系统表
// ============================================

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
